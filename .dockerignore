# Version control and local tooling
.git
.github
.gitignore
.gitattributes
.editorconfig
.idea
.vscode
.phpactor.json
.phpunit.cache
.phpunit.result.cache

# Secrets and local environment
.env
.env.*
auth.json

# Node / PHP dependencies (installed inside multi-stage build)
node_modules
vendor
composer.phar
pnpm-lock.yaml

# Local build output and dev-server marker
public/build
public/hot
public/storage

# Runtime state that must never be baked into the image
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/framework/testing/*
storage/app/private/*
storage/app/public/profile-images
database/*.sqlite*
bootstrap/cache/*.php

# Development-only files
tests
phpunit.xml
README.md
CLAUDE.md
AGENTS.md
