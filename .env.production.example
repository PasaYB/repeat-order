# Copy this file to `.env` on the deployment host.
#
# Docker Compose reads this file for variable interpolation. It is NOT copied
# into the Docker images and it is NOT used as Laravel's .env inside the
# container; the values below are passed through `compose.yaml`.
#
# Generate APP_KEY with: php artisan key:generate --show (or the PHP one-liner
# documented in the deployment notes).

APP_NAME="SuJa Selalu Ada"
APP_KEY=
APP_URL=https://your-domain.example
APP_TIMEZONE=UTC

# Image references. Build/push both images to GHCR and set the resulting refs.
# Use an immutable tag (for example the commit SHA) in production.
APP_IMAGE=ghcr.io/your-org/your-repo-app:latest
WEB_IMAGE=ghcr.io/your-org/your-repo-web:latest

# Laravel runtime
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=warning

SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=no-reply@your-domain.example
MAIL_FROM_NAME="SuJa Selalu Ada"

# The entrypoint runs `php artisan migrate --force` on startup. Set to false
# only if you run migrations as a separate deployment step. Never use
# migrate:fresh in production.
RUN_MIGRATIONS=true
